<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>impact.com Onboarding 流程管理台</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
:root{
  --bg:#F3F4F1; --panel:#FCFCFA; --ink:#15233F; --ink-2:#4A5568; --ink-3:#6A7280; --line:#DCE0E6; --line-2:#C5CCD8;
  --accent:#C9561E; --accent-soft:#F8E4D8; --focus:#2F5FB3;
  --lane-blue:#2F5FB3; --lane-blue-bg:#E6EDF8;
  --lane-orange:#C25A1E; --lane-orange-bg:#F9E7DC;
  --lane-violet:#6A4FB0; --lane-violet-bg:#ECE7F7;
  --lane-green:#257A4E; --lane-green-bg:#DFF0E6;
  --lane-slate:#3D4A60; --lane-slate-bg:#E3E7EE;
  --lane-red:#B13A2E; --lane-red-bg:#F7E1DE;
  --st-none:#8A93A3; --st-idea:#8A6A12; --st-idea-bg:#F6ECCB; --st-plan:#2F5FB3; --st-plan-bg:#E2EAF7; --st-pilot:#B3541A; --st-pilot-bg:#F8E2D3; --st-live:#1F6E45; --st-live-bg:#DCEFE3;
  --shadow:0 1px 2px rgba(21,35,63,.06),0 4px 14px rgba(21,35,63,.06);
  --f-body:'Noto Sans SC','PingFang SC','Microsoft YaHei',system-ui,sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0F1726; --panel:#172236; --ink:#E9EDF4; --ink-2:#B7C1D1; --ink-3:#8E9AAE; --line:#26334A; --line-2:#34435E;
  --accent:#F08A55; --accent-soft:#3A2418; --focus:#7FA6EC;
  --lane-blue:#7FA6EC; --lane-blue-bg:#1B2B47; --lane-orange:#F0975F; --lane-orange-bg:#35231A; --lane-violet:#B19CEB; --lane-violet-bg:#271F3F;
  --lane-green:#6CCB98; --lane-green-bg:#16302A; --lane-slate:#AAB6CA; --lane-slate-bg:#212C3F; --lane-red:#F08A7E; --lane-red-bg:#3A1E1C;
  --st-none:#7D889B; --st-idea:#E5C66A; --st-idea-bg:#3A3118; --st-plan:#8FB2F0; --st-plan-bg:#1C2B47; --st-pilot:#F3A270; --st-pilot-bg:#3A2418; --st-live:#7AD3A2; --st-live-bg:#163327;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 4px 14px rgba(0,0,0,.25); color-scheme:dark}}
*{box-sizing:border-box}
html,body{height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;line-height:1.5;margin:0}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}

body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--panel)}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--panel);border-bottom:1px solid var(--line);
  padding-block:12px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center}
.brand{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1 1 280px}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700}
.flow-title{font-size:20px;font-weight:900;margin:0;text-wrap:balance;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.flow-desc{color:var(--ink-2);font-size:13px;margin:0;max-width:70ch}
.stats{display:flex;gap:6px;flex-wrap:wrap}
.stat{display:flex;flex-direction:column;align-items:flex-start;padding:4px 12px;border-left:1px solid var(--line)}
.stat:first-child{border-left:none}
.stat b{font-family:var(--f-mono);font-size:18px;line-height:1.2}
.stat span{font-size:11px;color:var(--ink-3)}
.sync{font-size:12px;color:var(--ink-3);display:flex;align-items:center;gap:6px}
.sync i{width:8px;height:8px;border-radius:50%;background:var(--st-none);display:inline-block}
.sync.ok i{background:var(--st-live)} .sync.warn i{background:var(--st-pilot)}

.btn{border:1px solid var(--line-2);background:var(--panel);border-radius:8px;padding:6px 12px;font-size:13px;font-weight:500;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:hover{border-color:var(--ink-3)}
.btn.primary{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.btn.primary:hover{opacity:.9}
.btn.danger{color:var(--lane-red);border-color:var(--lane-red)}
.btn.ghost{border-color:transparent;background:transparent}
.btn.ghost:hover{background:var(--line)}
.btn.sm{padding:3px 8px;font-size:12px}
.btn:disabled{opacity:.45;cursor:not-allowed}

.shell{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:calc(100% - 80px)}
aside.rail{border-right:1px solid var(--line);padding:16px 12px 16px max(16px,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:10px}
.rail h2{font-size:12px;letter-spacing:.1em;color:var(--ink-3);margin:4px 4px 0;font-weight:700}
.flow-list{display:flex;flex-direction:column;gap:4px;list-style:none;margin:0;padding:0}
.flow-item{width:100%;text-align:left;border:1px solid transparent;background:transparent;border-radius:8px;padding:8px 10px;display:flex;flex-direction:column;gap:2px}
.flow-item:hover{background:var(--panel);border-color:var(--line)}
.flow-item.on{background:var(--panel);border-color:var(--line-2);box-shadow:var(--shadow)}
.flow-item b{font-size:14px;font-weight:700}
.flow-item span{font-size:12px;color:var(--ink-3)}
.legend{margin-top:auto;border-top:1px solid var(--line);padding-top:12px;display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--ink-2)}
.legend div{display:flex;align-items:center;gap:8px}

main{min-width:0;padding-block:16px 48px;padding-left:20px;padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:14px}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.search{flex:1 1 220px;min-width:0;border:1px solid var(--line-2);border-radius:8px;padding:6px 10px;background:var(--panel)}
.seg{display:inline-flex;border:1px solid var(--line-2);border-radius:8px;overflow:hidden}
.seg button{border:none;background:var(--panel);padding:6px 12px;font-size:13px}
.seg button+button{border-left:1px solid var(--line-2)}
.seg button.on{background:var(--ink);color:var(--bg)}
select.ctl{border:1px solid var(--line-2);border-radius:8px;padding:6px 8px;background:var(--panel)}

.banner{border:1px solid var(--line-2);background:var(--panel);border-radius:10px;padding:10px 14px;font-size:13px;color:var(--ink-2)}

/* Swimlanes */
.lanes{display:flex;flex-direction:column;gap:12px}
.lane{background:var(--panel);border:1px solid var(--line);border-radius:12px;display:grid;grid-template-columns:168px minmax(0,1fr);overflow:hidden}
.lane-head{padding:14px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:8px;background:var(--lane-bg)}
.lane-head h3{margin:0;font-size:15px;font-weight:700;color:var(--lane-fg);display:flex;align-items:center;gap:8px}
.lane-head h3::before{content:"";width:10px;height:10px;border-radius:3px;background:var(--lane-fg);flex:none}
.lane-head .meta{font-size:12px;color:var(--ink-2)}
.lane-head .acts{display:flex;gap:4px;flex-wrap:wrap;margin-top:auto}
.track{overflow-x:auto;padding:14px;display:flex;align-items:stretch;gap:0}
.arrow{flex:none;width:26px;display:flex;align-items:center;justify-content:center;color:var(--ink-3)}
.arrow svg{width:18px;height:18px}
.card{flex:none;width:228px;text-align:left;border:1px solid var(--line);border-top:3px solid var(--lane-fg);background:var(--panel);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;box-shadow:var(--shadow);transition:transform .12s,opacity .12s}
.card:hover{transform:translateY(-1px);border-color:var(--line-2)}
.card.sel{outline:2px solid var(--focus);outline-offset:1px}
.card.dim{opacity:.32}
.card .row{display:flex;align-items:center;gap:6px;justify-content:space-between}
.card .num{font-family:var(--f-mono);font-size:11px;color:var(--ink-3)}
.type{font-size:11px;font-weight:700;border-radius:4px;padding:1px 6px;display:inline-flex;align-items:center;gap:4px}
.type.task{background:var(--lane-slate-bg);color:var(--lane-slate)}
.type.decision{background:var(--st-idea-bg);color:var(--st-idea)}
.type.start,.type.end{background:var(--lane-green-bg);color:var(--lane-green)}
.type.stop{background:var(--lane-red-bg);color:var(--lane-red)}
.card .t{font-weight:700;font-size:14px;line-height:1.4}
.card .who{font-size:12px;color:var(--ink-2)}
.card .br{font-size:12px;color:var(--ink-2);border-left:2px solid var(--line-2);padding-left:8px}
.card .ai{font-size:12px;color:var(--ink-2);background:var(--bg);border-radius:6px;padding:6px 8px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card .ai b{color:var(--accent);font-weight:700}
.pill{font-size:11px;font-weight:700;border-radius:999px;padding:1px 8px;white-space:nowrap}
.pill.none{color:var(--st-none);border:1px dashed var(--st-none)}
.pill.idea{background:var(--st-idea-bg);color:var(--st-idea)}
.pill.plan{background:var(--st-plan-bg);color:var(--st-plan)}
.pill.pilot{background:var(--st-pilot-bg);color:var(--st-pilot)}
.pill.live{background:var(--st-live-bg);color:var(--st-live)}
.phase{font-family:var(--f-mono);font-size:11px;color:var(--ink-3)}
.add-card{flex:none;width:120px;border:1.5px dashed var(--line-2);background:transparent;border-radius:10px;color:var(--ink-3);font-size:13px;margin-left:12px}
.add-card:hover{color:var(--ink);border-color:var(--ink-3)}
.empty-lane{color:var(--ink-3);font-size:13px;align-self:center;padding-right:8px}

/* Table */
.tbl-wrap{overflow-x:auto;background:var(--panel);border:1px solid var(--line);border-radius:12px}
table{border-collapse:collapse;width:100%;min-width:980px;font-size:13px}
th{text-align:left;font-size:12px;color:var(--ink-3);font-weight:700;padding:10px 12px;border-bottom:1px solid var(--line-2);position:sticky;top:0;background:var(--panel)}
td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
tr.click{cursor:pointer} tr.click:hover td{background:var(--bg)}
td .lane-tag{font-size:12px;font-weight:700;color:var(--lane-fg)}

/* Drawer */
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:var(--panel);border-left:1px solid var(--line-2);box-shadow:-12px 0 32px rgba(21,35,63,.14);z-index:40;display:flex;flex-direction:column;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-right:env(safe-area-inset-right,0px);transform:translateX(105%);transition:transform .18s ease}
.drawer.open{transform:none}
.drawer-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 18px;border-bottom:1px solid var(--line)}
.drawer-head h2{margin:0;font-size:16px}
.drawer-body{flex:1;overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:14px}
.drawer-foot{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--line)}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:12px;font-weight:700;color:var(--ink-2)}
.field .hint{font-size:11px;color:var(--ink-3)}
.field input,.field select,.field textarea{border:1px solid var(--line-2);border-radius:8px;padding:7px 10px;background:var(--bg);width:100%}
.field textarea{resize:vertical;min-height:64px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sec{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:700;border-top:1px solid var(--line);padding-top:12px}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.sw{width:30px;height:30px;border-radius:8px;border:2px solid transparent;background:var(--lane-fg)}
.sw.on{border-color:var(--ink);box-shadow:0 0 0 2px var(--panel) inset}
.scrim{position:fixed;inset:0;background:rgba(15,23,38,.35);z-index:35}

.modal-wrap{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,38,.45)}
.modal{background:var(--panel);border-radius:14px;max-width:440px;width:100%;padding:20px;display:flex;flex-direction:column;gap:14px;box-shadow:var(--shadow)}
.modal h3{margin:0;font-size:17px}
.modal p{margin:0;color:var(--ink-2)}
.modal .acts{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
.choice{display:flex;gap:8px;align-items:flex-start;border:1px solid var(--line-2);border-radius:10px;padding:10px 12px;cursor:pointer}
.choice input{margin-top:4px}
.choice b{display:block}
.choice span{font-size:12px;color:var(--ink-3)}

.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:999px;font-size:13px;z-index:60;box-shadow:var(--shadow)}

.state{background:var(--panel);border:1px dashed var(--line-2);border-radius:12px;padding:36px 24px;text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center;color:var(--ink-2)}
.state h3{margin:0;color:var(--ink);font-size:17px}

@media (max-width:860px){
  .shell{grid-template-columns:minmax(0,1fr)}
  aside.rail{border-right:none;border-bottom:1px solid var(--line);padding:12px max(16px,env(safe-area-inset-right,0px)) 12px max(16px,env(safe-area-inset-left,0px))}
  .flow-list{flex-direction:row;overflow-x:auto}
  .flow-item{width:auto;min-width:160px}
  .legend{display:none}
  main{padding-left:max(16px,env(safe-area-inset-left,0px))}
  .lane{grid-template-columns:minmax(0,1fr)}
  .lane-head{border-right:none;border-bottom:1px solid var(--line);flex-direction:row;flex-wrap:wrap;align-items:center}
  .lane-head .acts{margin-top:0;margin-left:auto}
  .grid2{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){.drawer,.card{transition:none}}
</style>
</head>
<body>
<header class="top">
  <div class="brand">
    <span class="eyebrow">impact.com · Onboarding 流程管理</span>
    <h1 class="flow-title" id="flowTitle">加载中…</h1>
    <p class="flow-desc" id="flowDesc"></p>
  </div>
  <div class="stats" id="stats"></div>
  <div class="sync" id="sync"><i></i><span>连接中</span></div>
</header>

<div class="shell">
  <aside class="rail">
    <h2>流程</h2>
    <ul class="flow-list" id="flowList"></ul>
    <button class="btn" id="btnNewFlow" type="button">＋ 新建流程</button>
    <div class="legend">
      <div><span class="type task">任务</span>普通环节</div>
      <div><span class="type decision">◇ 决策</span>有分支的判断点</div>
      <div><span class="type start">● 起点 / 终点</span></div>
      <div><span class="type stop">■ 中止</span>流程在此结束</div>
      <div style="margin-top:6px;flex-wrap:wrap"><span class="pill idea">待评估</span><span class="pill plan">规划中</span><span class="pill pilot">试点中</span><span class="pill live">已上线</span></div>
    </div>
  </aside>

  <main>
    <div class="toolbar">
      <input class="search" id="q" type="search" placeholder="搜索环节、负责人、工具或 AI 方案…" aria-label="搜索">
      <select class="ctl" id="fOwner" aria-label="按负责人筛选"><option value="">全部负责人</option></select>
      <select class="ctl" id="fAi" aria-label="按 AI 状态筛选">
        <option value="">全部 AI 状态</option><option value="has">有 AI 方案</option>
        <option value="idea">待评估</option><option value="plan">规划中</option><option value="pilot">试点中</option><option value="live">已上线</option>
      </select>
      <div class="seg" role="tablist" aria-label="视图">
        <button type="button" id="vBoard" class="on">泳道图</button>
        <button type="button" id="vTable">清单</button>
      </div>
      <button class="btn" type="button" id="btnFlowSettings">流程设置</button>
      <button class="btn" type="button" id="btnAddLane">＋ 泳道</button>
      <button class="btn" type="button" id="btnExport">导出 JSON</button>
      <label class="btn" for="importFile" id="btnImport">导入 JSON</label>
      <input type="file" id="importFile" accept="application/json,.json" hidden>
    </div>
    <div id="banner" class="banner" hidden></div>
    <div id="view"></div>
  </main>
</div>

<div class="scrim" id="scrim" hidden></div>
<section class="drawer" id="drawer" aria-label="编辑面板">
  <div class="drawer-head"><h2 id="dTitle">编辑</h2><button class="btn ghost" type="button" id="dClose" aria-label="关闭">✕</button></div>
  <div class="drawer-body" id="dBody"></div>
  <div class="drawer-foot" id="dFoot"></div>
</section>
<div id="modalRoot"></div>
<div class="toast" id="toast" hidden></div>

<script>
const TEMPLATE = {"name": "AOR 对接流程", "desc": "从客户提出 AOR 需求到 IE 完成上线交付的端到端流程，含 CSM / IE 两条入口与费用减免分支。", "order": 1, "lanes": [{"id": "l-start", "name": "启动", "color": "green"}, {"id": "l-csm", "name": "CSM 路径", "color": "blue"}, {"id": "l-ie", "name": "IE 路径", "color": "orange"}, {"id": "l-waiver", "name": "费用减免分支", "color": "violet"}, {"id": "l-deliv", "name": "IE 交付对接", "color": "slate"}], "steps": [{"id": "s01", "lane": "l-start", "type": "start", "title": "启动流程：判断是 CSM 还是 IE 收集需求", "owner": "", "tools": "", "branches": "CSM → CSM 路径；IE → IE 路径", "desc": "", "ai": "根据需求来源（邮件、表单、Ticket）自动识别入口并路由到对应路径", "guard": "", "aiStatus": "idea", "aiPhase": "P2"}, {"id": "s02", "lane": "l-csm", "type": "task", "title": "客户向 CSM 提出 AOR 需求", "owner": "客户 → CSM", "tools": "邮件", "branches": "", "desc": "", "ai": "", "guard": "", "aiStatus": "none", "aiPhase": ""}, {"id": "s03", "lane": "l-csm", "type": "task", "title": "给客户发送技术需求表", "owner": "CSM", "tools": "技术需求表", "branches": "", "desc": "", "ai": "根据客户类型与已知信息预填需求表；客户提交后自动校验完整性，并起草追问缺失字段的邮件", "guard": "CSM 确认后发送", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s04", "lane": "l-csm", "type": "task", "title": "客户填写后收到邮件提示，CSM 发送邮件至 William & Emerson", "owner": "CSM", "tools": "邮件", "branches": "", "desc": "", "ai": "把表单与邮件整理成结构化需求摘要（集成方式、追踪方案、时间要求等），自动建 Ticket", "guard": "William 确认", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s05", "lane": "l-csm", "type": "decision", "title": "William 通过 Ticket 报价，CSM 邮件告知客户", "owner": "William / CSM", "tools": "Ticket、邮件", "branches": "客户接受报价 → 收集对接人信息；客户不接受报价 → 流程中止", "desc": "", "ai": "按工时与价格规则生成 Ticket 报价说明，以及发给客户的报价邮件草稿", "guard": "William 审核价格", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s06", "lane": "l-csm", "type": "task", "title": "CSM 收集客户技术对接人、合同签署人信息", "owner": "CSM", "tools": "邮件", "branches": "", "desc": "", "ai": "从邮件往来中识别技术对接人、合同签署人及联系方式，写入后续建单所需字段", "guard": "CSM 核对", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s07", "lane": "l-csm", "type": "task", "title": "创建 SFDC AOR