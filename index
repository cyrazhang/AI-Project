hes": "", "desc": "", "ai": "起草给 AE 的报价说明，附工作范围", "guard": "IE 确认后发出", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s16", "lane": "l-ie", "type": "decision", "title": "IE @AE 让客户签署 Addendum", "owner": "IE → AE", "tools": "", "branches": "客户接受报价 → AE 完成商务流程；客户不接受报价 → 费用减免分支", "desc": "", "ai": "跟踪报价确认与签署状态，超时提醒 AE", "guard": "", "aiStatus": "idea", "aiPhase": "P2"}, {"id": "s17", "lane": "l-ie", "type": "task", "title": "AE 完成商务流程", "owner": "AE", "tools": "", "branches": "", "desc": "", "ai": "跟踪商务流程状态，超时提醒", "guard": "", "aiStatus": "idea", "aiPhase": "P2"}, {"id": "s18", "lane": "l-ie", "type": "task", "title": "AE @IE 客户已签署合同，并上传合同文档", "owner": "AE → IE", "tools": "", "branches": "→ 进入 IE 交付对接", "desc": "", "ai": "合同上传后自动生成交接简报并通知 IE", "guard": "IE 接收确认", "aiStatus": "idea", "aiPhase": "P2"}, {"id": "s19", "lane": "l-waiver", "type": "decision", "title": "AE 判断是否免除费用，申请免除", "owner": "AE", "tools": "", "branches": "是 → Louis 批准；否 → 未批准，终止", "desc": "", "ai": "汇总客户背景、需求范围与沟通记录，起草费用减免申请", "guard": "AE 判断，Louis 审批", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s20", "lane": "l-waiver", "type": "task", "title": "Louis 批准", "owner": "Louis", "tools": "", "branches": "→ 回到「AE 完成商务流程」", "desc": "", "ai": "", "guard": "", "aiStatus": "none", "aiPhase": ""}, {"id": "s21", "lane": "l-waiver", "type": "stop", "title": "未批准，价格未谈拢，终止", "owner": "", "tools": "", "branches": "", "desc": "", "ai": "", "guard": "", "aiStatus": "none", "aiPhase": ""}, {"id": "s22", "lane": "l-deliv", "type": "task", "title": "根据沟通方式确定发邮件还是群沟通", "owner": "IE", "tools": "邮件、群", "branches": "", "desc": "", "ai": "按客户偏好渠道起草启动邮件、进度更新与会议纪要", "guard": "IE 确认后发出", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s23", "lane": "l-deliv", "type": "task", "title": "根据需求在客户账号里创建相应内容", "owner": "IE", "tools": "客户账号", "branches": "", "desc": "", "ai": "根据需求摘要生成需创建内容的清单与参数草案", "guard": "IE 在账号中执行", "aiStatus": "idea", "aiPhase": "P2"}, {"id": "s24", "lane": "l-deliv", "type": "task", "title": "在 operator 出技术文档，然后修改", "owner": "IE", "tools": "operator", "branches": "", "desc": "", "ai": "以导出的文档为底稿，按客户需求改写对应章节、补充 FAQ，并标出修改处", "guard": "IE 审阅修改处", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s25", "lane": "l-deliv", "type": "task", "title": "指导客户完成测试", "owner": "IE", "tools": "", "branches": "", "desc": "", "ai": "生成分步测试指引；读取客户反馈的测试结果，匹配常见问题并给出排查建议", "guard": "IE 判断根因", "aiStatus": "idea", "aiPhase": "P3"}, {"id": "s26", "lane": "l-deliv", "type": "task", "title": "检查客户配置情况", "owner": "IE", "tools": "客户账号", "branches": "", "desc": "一般有 workflow、合同、general 和 gateway 等", "ai": "对照 Review Checklist 逐项核查配置，输出差异与风险清单", "guard": "IE 确认后上线", "aiStatus": "idea", "aiPhase": "P3"}, {"id": "s27", "lane": "l-deliv", "type": "task", "title": "没问题后上线", "owner": "IE", "tools": "", "branches": "", "desc": "", "ai": "", "guard": "", "aiStatus": "none", "aiPhase": ""}, {"id": "s28", "lane": "l-deliv", "type": "task", "title": "onb AOR 需要 AE 拉 CSM 进有 IE 的群", "owner": "AE", "tools": "群", "branches": "", "desc": "仅适用于 onboarding 阶段的 AOR", "ai": "识别 onb AOR 后自动提醒 AE 拉群", "guard": "", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s29", "lane": "l-deliv", "type": "task", "title": "关闭 Ticket，评论回复 AOR 已完成，附 Review Checklist 链接", "owner": "IE", "tools": "Ticket", "branches": "", "desc": "", "ai": "生成 Ticket 完成评论，同步通知 CSM、AE、William", "guard": "IE 一键确认关闭", "aiStatus": "idea", "aiPhase": "P1"}, {"id": "s30", "lane": "l-deliv", "type": "end", "title": "流程完成", "owner": "", "tools": "", "branches": "", "desc": "", "ai": "沉淀本次需求、工时、问题与解法到 AOR 知识库", "guard": "定期抽检", "aiStatus": "idea", "aiPhase": "P3"}]};
const TYPES = {task:'任务',decision:'◇ 决策',start:'● 起点',end:'● 终点',stop:'■ 中止'};
const AI_ST = {none:'无',idea:'待评估',plan:'规划中',pilot:'试点中',live:'已上线'};
const COLORS = ['blue','orange','violet','green','slate','red'];
const COL_NAME = {blue:'蓝',orange:'橙',violet:'紫',green:'绿',slate:'灰',red:'红'};
const LOCAL_KEY = 'aor-flow-manager-v1';

let db = null, mode = 'loading', canWrite = true;
let flows = {};
let curId = null;
let view = 'board';
let sel = null;
let filters = {q:'',owner:'',ai:''};
const writeChain = {};

const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = p => p + '-' + Math.random().toString(36).slice(2, 9);
const clone = o => JSON.parse(JSON.stringify(o));
const laneVars = c => `--lane-fg:var(--lane-${COLORS.includes(c)?c:'slate'});--lane-bg:var(--lane-${COLORS.includes(c)?c:'slate'}-bg)`;

function toast(msg){const t=$('#toast');t.textContent=msg;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(()=>t.hidden=true,2200)}
function setSync(cls,txt){const s=$('#sync');s.className='sync '+cls;s.querySelector('span').textContent=txt}
function banner(html){const b=$('#banner');if(!html){b.hidden=true;return}b.innerHTML=html;b.hidden=false}

function normFlow(f){
  f = f && typeof f==='object' ? f : {};
  return {name:String(f.name||'未命名流程'),desc:String(f.desc||''),order:Number(f.order)||0,updatedAt:Number(f.updatedAt)||0,
    lanes:Array.isArray(f.lanes)?f.lanes.filter(l=>l&&l.id).map(l=>({id:String(l.id),name:String(l.name||'泳道'),color:COLORS.includes(l.color)?l.color:'slate'})):[],
    steps:Array.isArray(f.steps)?f.steps.filter(s=>s&&s.id).map(s=>({id:String(s.id),lane:String(s.lane||''),type:TYPES[s.type]?s.type:'task',title:String(s.title||'新环节'),owner:String(s.owner||''),tools:String(s.tools||''),branches:String(s.branches||''),desc:String(s.desc||''),ai:String(s.ai||''),guard:String(s.guard||''),aiStatus:AI_ST[s.aiStatus]?s.aiStatus:(s.ai?'idea':'none'),aiPhase:String(s.aiPhase||'')})):[]};
}

function loadLocal(){try{const raw=localStorage.getItem(LOCAL_KEY);if(raw){const o=JSON.parse(raw);return o&&typeof o==='object'?o:null}}catch(e){}return null}
function saveLocal(){try{localStorage.setItem(LOCAL_KEY,JSON.stringify(flows))}catch(e){}}

async function persist(id){
  const f = flows[id]; if(!f) return;
  f.updatedAt = Date.now();
  if(mode==='db'){
    const body = clone(f);
    writeChain[id] = (writeChain[id]||Promise.resolve()).then(()=>db.collection('flows').doc(id).set(body)).then(()=>setSync('ok','已同步'),e=>{
      if(e&&e.code==='invalid_argument'){canWrite=false;applyWriteState();toast('你没有编辑权限，修改未保存')}
      else if(e&&e.code==='quota_exceeded'){toast('存储已满，请删除不再使用的流程')}
      else toast('保存失败，请稍后重试');
      setSync('warn','未同步');
    });
    setSync('', '保存中…');
    return writeChain[id];
  } else { saveLocal(); }
}
async function removeFlow(id){
  delete flows[id];
  if(mode==='db'){try{await db.collection('flows').doc(id).delete()}catch(e){toast('删除失败')}}
  else saveLocal();
}

function cur(){return flows[curId]}
function sortedFlows(){return Object.entries(flows).sort((a,b)=>(a[1].order-b[1].order)||a[1].name.localeCompare(b[1].name,'zh'))}
function laneSteps(f,laneId){return f.steps.filter(s=>s.lane===laneId)}
function matches(s){
  const q=filters.q.trim().toLowerCase();
  if(q && ![s.title,s.owner,s.tools,s.desc,s.ai,s.branches,s.guard].join(' ').toLowerCase().includes(q)) return false;
  if(filters.owner && !splitOwners(s.owner).includes(filters.owner)) return false;
  if(filters.ai==='has' && !s.ai) return false;
  if(filters.ai && filters.ai!=='has' && s.aiStatus!==filters.ai) return false;
  return true;
}
function splitOwners(o){return String(o).split(/[\/→、,，\s]+/).map(x=>x.trim()).filter(x=>x&&x!=='—')}
function filtering(){return !!(filters.q.trim()||filters.owner||filters.ai)}

function render(){
  renderFlowList();
  const f = cur();
  if(!f){
    $('#flowTitle').textContent = mode==='loading'?'加载中…':'还没有流程';
    $('#flowDesc').textContent=''; $('#stats').innerHTML='';
    $('#view').innerHTML = mode==='loading'
      ? `<div class="state"><h3>正在读取流程…</h3><p>流程数据保存在这个页面里，团队成员打开时看到的是同一份。</p></div>`
      : `<div class="state"><h3>这里还没有流程</h3><p>新建一个空白流程，或从「AOR 对接流程」模板开始，再按实际情况编辑环节。</p><button class="btn primary" type="button" data-act="newflow">＋ 新建流程</button></div>`;
    return;
  }
  $('#flowTitle').innerHTML = esc(f.name);
  $('#flowDesc').textContent = f.desc;
  const withAi=f.steps.filter(s=>s.ai), cnt=k=>f.steps.filter(s=>s.aiStatus===k).length;
  $('#stats').innerHTML = [[f.steps.length,'环节'],[f.lanes.length,'泳道'],[withAi.length,'有 AI 方案'],[cnt('pilot'),'试点中'],[cnt('live'),'已上线']]
    .map(([n,l])=>`<div class="stat"><b>${n}</b><span>${l}</span></div>`).join('');
  const owners=[...new Set(f.steps.flatMap(s=>splitOwners(s.owner)))].sort((a,b)=>a.localeCompare(b,'zh'));
  const fo=$('#fOwner'), prev=filters.owner;
  fo.innerHTML='<option value="">全部负责人</option>'+owners.map(o=>`<option value="${esc(o)}">${esc(o)}</option>`).join('');
  fo.value=owners.includes(prev)?prev:''; filters.owner=fo.value;
  view==='board'?renderBoard(f):renderTable(f);
}
function renderFlowList(){
  $('#flowList').innerHTML = sortedFlows().map(([id,f])=>`<li><button type="button" class="flow-item ${id===curId?'on':''}" data-flow="${esc(id)}"><b>${esc(f.name)}</b><span>${f.steps.length} 个环节 · ${f.lanes.length} 条泳道</span></button></li>`).join('');
}
const ARROW='<span class="arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>';
function cardHtml(s,i){
  const dim = filtering() && !matches(s);
  return `<button type="button" class="card ${sel&&sel.kind==='step'&&sel.id===s.id?'sel':''} ${dim?'dim':''}" data-step="${esc(s.id)}">
    <div class="row"><span class="type ${s.type}">${TYPES[s.type]}</span><span class="num">#${String(i+1).padStart(2,'0')}</span></div>
    <div class="t">${esc(s.title)}</div>
    ${s.owner||s.tools?`<div class="who">${s.owner?esc(s.owner):''}${s.owner&&s.tools?' · ':''}${s.tools?esc(s.tools):''}</div>`:''}
    ${s.branches?`<div class="br">${esc(s.branches)}</div>`:''}
    ${s.ai?`<div class="ai"><b>AI</b> ${esc(s.ai)}</div>`:''}
    <div class="row"><span class="pill ${s.aiStatus}">${s.aiStatus==='none'?'无 AI 方案':AI_ST[s.aiStatus]}</span>${s.aiPhase?`<span class="phase">${esc(s.aiPhase)}</span>`:''}</div>
  </button>`;
}
function renderBoard(f){
  if(!f.lanes.length){$('#view').innerHTML=`<div class="state"><h3>这个流程还没有泳道</h3><p>泳道代表一条路径或一个阶段，例如「CSM 路径」「IE 交付对接」。</p>${canWrite?'<button class="btn primary" type="button" data-act="addlane">＋ 添加泳道</button>':''}</div>`;return}
  let n=0;
  $('#view').innerHTML='<div class="lanes">'+f.lanes.map((l,li)=>{
    const st=laneSteps(f,l.id);
    const cards=st.map(s=>cardHtml(s,n++)).join(ARROW);
    return `<section class="lane" style="${laneVars(l.color)}">
      <div class="lane-head"><h3>${esc(l.name)}</h3><span class="meta">${st.length} 个环节 · ${st.filter(s=>s.ai).length} 个 AI 方案</span>
        ${canWrite?`<div class="acts"><button class="btn sm ghost" type="button" data-lanemove="${esc(l.id)}" data-dir="-1" ${li===0?'disabled':''} aria-label="上移泳道">↑</button><button class="btn sm ghost" type="button" data-lanemove="${esc(l.id)}" data-dir="1" ${li===f.lanes.length-1?'disabled':''} aria-label="下移泳道">↓</button><button class="btn sm" type="button" data-laneedit="${esc(l.id)}">编辑</button></div>`:''}</div>
      <div class="track">${cards||'<span class="empty-lane">还没有环节</span>'}${canWrite?`<button type="button" class="add-card" data-addstep="${esc(l.id)}">＋ 添加环节</button>`:''}</div>
    </section>`;
  }).join('')+'</div>';
  const orphan=f.steps.filter(s=>!f.lanes.some(l=>l.id===s.lane));
  if(orphan.length) banner(`有 ${orphan.length} 个环节不属于任何泳道，可以在「清单」视图中找到并重新分配。`); else if(mode!=='local') banner('');
}
function renderTable(f){
  const laneOf=id=>f.lanes.find(l=>l.id===id);
  const order=[];f.lanes.forEach(l=>order.push(...laneSteps(f,l.id)));f.steps.forEach(s=>{if(!laneOf(s.lane))order.push(s)});
  const rows=order.filter(s=>!filtering()||matches(s));
  $('#view').innerHTML=`<div class="tbl-wrap"><table><thead><tr><th>#</th><th>泳道</th><th>环节</th><th>类型</th><th>负责人</th><th>工具</th><th>AI 优化方案</th><th>人工把关</th><th>状态</th><th>阶段</th></tr></thead><tbody>${
    rows.length?rows.map(s=>{const l=laneOf(s.lane);return `<tr class="click" data-step="${esc(s.id)}" tabindex="0">
      <td class="mono">${order.indexOf(s)+1}</td>
      <td style="${laneVars(l?l.color:'red')}"><span class="lane-tag">${l?esc(l.name):'未分配'}</span></td>
      <td><b>${esc(s.title)}</b>${s.branches?`<div style="color:var(--ink-3);font-size:12px">${esc(s.branches)}</div>`:''}</td>
      <td><span class="type ${s.type}">${TYPES[s.type]}</span></td>
      <td>${esc(s.owner)}</td><td>${esc(s.tools)}</td><td style="min-width:240px">${esc(s.ai)}</td><td>${esc(s.guard)}</td>
      <td><span class="pill ${s.aiStatus}">${AI_ST[s.aiStatus]}</span></td><td class="mono">${esc(s.aiPhase)}</td></tr>`}).join('')
    :'<tr><td colspan="10" style="text-align:center;color:var(--ink-3);padding:28px">没有符合筛选条件的环节</td></tr>'}</tbody></table></div>`;
}

function openDrawer(title,body,foot){
  $('#dTitle').textContent=title;$('#dBody').innerHTML=body;$('#dFoot').innerHTML=foot;
  $('#drawer').classList.add('open');$('#scrim').hidden=false;
  setTimeout(()=>{const i=$('#dBody').querySelector('input,textarea,select');i&&i.focus()},60);
}
function closeDrawer(){$('#drawer').classList.remove('open');$('#scrim').hidden=true;sel=null;render()}
const ro=()=>canWrite?'':'disabled';

function editStep(id){
  const f=cur(),s=f.steps.find(x=>x.id===id);if(!s)return;
  sel={kind:'step',id};render();
  const laneOpts=f.lanes.map(l=>`<option value="${esc(l.id)}" ${l.id===s.lane?'selected':''}>${esc(l.name)}</option>`).join('');
  openDrawer(canWrite?'编辑环节':'环节详情',`
    <div class="field"><label for="e_title">环节名称</label><input id="e_title" value="${esc(s.title)}" ${ro()}></div>
    <div class="grid2">
      <div class="field"><label for="e_type">类型</label><select id="e_type" ${ro()}>${Object.entries(TYPES).map(([k,v])=>`<option value="${k}" ${k===s.type?'selected':''}>${v}</option>`).join('')}</select></div>
      <div class="field"><label for="e_lane">所属泳道</label><select id="e_lane" ${ro()}>${laneOpts}</select></div>
    </div>
    <div class="grid2">
      <div class="field"><label for="e_owner">负责人</label><input id="e_owner" value="${esc(s.owner)}" placeholder="如 CSM、IE → AE" ${ro()}></div>
      <div class="field"><label for="e_tools">工具 / 载体</label><input id="e_tools" value="${esc(s.tools)}" placeholder="如 SFDC、Ticket" ${ro()}></div>
    </div>
    <div class="field"><label for="e_branches">分支 / 去向</label><input id="e_branches" value="${esc(s.branches)}" placeholder="如 接受 → 下一步；不接受 → 流程中止" ${ro()}><span class="hint">决策点写清每个结果去哪里，用分号隔开。</span></div>
    <div class="field"><label for="e_desc">说明</label><textarea id="e_desc" ${ro()}>${esc(s.desc)}</textarea></div>
    <div class="sec">AI 优化</div>
    <div class="field"><label for="e_ai">AI 如何承担这一步的重复性工作</label><textarea id="e_ai" rows="3" ${ro()}>${esc(s.ai)}</textarea></div>
    <div class="field"><label for="e_guard">人工把关</label><input id="e_guard" value="${esc(s.guard)}" placeholder="谁在哪一步确认 AI 的输出" ${ro()}></div>
    <div class="grid2">
      <div class="field"><label for="e_st">AI 状态</label><select id="e_st" ${ro()}>${Object.entries(AI_ST).map(([k,v])=>`<option value="${k}" ${k===s.aiStatus?'selected':''}>${v}</option>`).join('')}</select></div>
      <div class="field"><label for="e_phase">落地阶段</label><select id="e_phase" ${ro()}>${['','P1','P2','P3'].map(p=>`<option value="${p}" ${p===s.aiPhase?'selected':''}>${p||'未定'}</option>`).join('')}</select></div>
    </div>
    ${canWrite?`<div class="sec">位置</div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn" type="button" data-stepmove="-1">← 前移</button><button class="btn" type="button" data-stepmove="1">后移 →</button><button class="btn" type="button" id="e_insert">在后面插入环节</button><button class="btn" type="button" id="e_dup">复制</button></div>`:''}`,
    canWrite?`<button class="btn danger" type="button" id="e_del">删除环节</button><span style="display:flex;gap:8px"><button class="btn" type="button" data-close>取消</button><button class="btn primary" type="button" id="e_save">保存</button></span>`:`<button class="btn" type="button" data-close>关闭</button>`);
}
function readStepForm(s){
  const v=id=>$('#'+id).value;
  Object.assign(s,{title:v('e_title').trim()||'新环节',type:v('e_type'),owner:v('e_owner').trim(),tools:v('e_tools').trim(),branches:v('e_branches').trim(),desc:v('e_desc').trim(),ai:v('e_ai').trim(),guard:v('e_guard').trim(),aiStatus:v('e_st'),aiPhase:v('e_phase')});
  const newLane=v('e_lane');
  if(newLane!==s.lane){const f=cur();f.steps=f.steps.filter(x=>x!==s);s.lane=newLane;const last=f.steps.map(x=>x.lane).lastIndexOf(newLane);f.steps.splice(last+1,0,s)}
}
function moveStep(id,dir){
  const f=cur(),s=f.steps.find(x=>x.id===id);const same=laneSteps(f,s.lane);const i=same.indexOf(s),j=i+dir;
  if(j<0||j>=same.length)return false;
  const a=f.steps.indexOf(s),b=f.steps.indexOf(same[j]);[f.steps[a],f.steps[b]]=[f.steps[b],f.steps[a]];return true;
}
function addStep(laneId,afterId){
  const f=cur();const s=normFlow({steps:[{id:uid('s'),lane:laneId,title:'新环节',type:'task'}]}).steps[0];
  let idx;
  if(afterId){idx=f.steps.findIndex(x=>x.id===afterId)+1}else{idx=f.steps.map(x=>x.lane).lastIndexOf(laneId)+1;if(idx===0)idx=f.steps.length}
  f.steps.splice(idx,0,s);persist(curId);editStep(s.id);
  setTimeout(()=>{const t=$('#e_title');t&&t.select()},80);
}

function editLane(id){
  const f=cur(),l=id?f.lanes.find(x=>x.id===id):null;
  sel={kind:'lane',id};
  const color=l?l.color:COLORS[f.lanes.length%COLORS.length];
  openDrawer(l?'编辑泳道':'添加泳道',`
    <div class="field"><label for="l_name">泳道名称</label><input id="l_name" value="${esc(l?l.name:'')}" placeholder="如 CSM 路径、IE 交付对接"></div>
    <div class="field"><label>颜色</label><div class="swatches" id="l_color" data-val="${color}">${COLORS.map(c=>`<button type="button" class="sw ${c===color?'on':''}" style="${laneVars(c)}" data-color="${c}" aria-label="${COL_NAME[c]}色"></button>`).join('')}</div></div>
    ${l?`<p style="color:var(--ink-3);font-size:12px;margin:0">删除泳道时，其中的 ${laneSteps(f,l.id).length} 个环节也会一并删除。</p>`:''}`,
    `${l?'<button class="btn danger" type="button" id="l_del">删除泳道</button>':'<span></span>'}<span style="display:flex;gap:8px"><button class="btn" type="button" data-close>取消</button><button class="btn primary" type="button" id="l_save">${l?'保存':'添加'}</button></span>`);
}
function editFlow(){
  const f=cur();if(!f)return;sel={kind:'flow',id:curId};
  openDrawer('流程设置',`
    <div class="field"><label for="f_name">流程名称</label><input id="f_name" value="${esc(f.name)}" ${ro()}></div>
    <div class="field"><label for="f_desc">简介</label><textarea id="f_desc" rows="3" ${ro()}>${esc(f.desc)}</textarea></div>
    <div class="field"><label for="f_order">排序</label><input id="f_order" type="number" value="${f.order}" ${ro()}><span class="hint">数字小的排在左侧流程列表前面。</span></div>
    <p style="color:var(--ink-3);font-size:12px;margin:0">最后更新：${f.updatedAt?new Date(f.updatedAt).toLocaleString('zh-CN'):'—'}</p>
    ${canWrite?'<div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn" type="button" id="f_dup">复制为新流程</button></div>':''}`,
    canWrite?`<button class="btn danger" type="button" id="f_del">删除流程</button><span style="display:flex;gap:8px"><button class="btn" type="button" data-close>取消</button><button class="btn primary" type="button" id="f_save">保存</button></span>`:'<button class="btn" type="button" data-close>关闭</button>');
}

function modal(html){$('#modalRoot').innerHTML=`<div class="modal-wrap" id="mw"><div class="modal" role="dialog" aria-modal="true">${html}</div></div>`;setTimeout(()=>{const i=$('#mw input:not([type=radio]),#mw button.primary');i&&i.focus()},30)}
function closeModal(){$('#modalRoot').innerHTML=''}
function confirmBox(title,text,okLabel,onOk){
  modal(`<h3>${esc(title)}</h3><p>${esc(text)}</p><div class="acts"><button class="btn" type="button" data-mclose>取消</button><button class="btn primary" type="button" id="mOk" style="background:var(--lane-red);border-color:var(--lane-red)">${esc(okLabel)}</button></div>`);
  $('#mOk').onclick=()=>{closeModal();onOk()};
}
function newFlowModal(){
  modal(`<h3>新建流程</h3>
    <div class="field"><label for="n_name">流程名称</label><input id="n_name" placeholder="如 AOR 变更流程"></div>
    <label class="choice"><input type="radio" name="n_src" value="tpl" checked><div><b>从 AOR 对接流程模板开始</b><span>包含 5 条泳道、${TEMPLATE.steps.length} 个环节及 AI 优化方案</span></div></label>
    <label class="choice"><input type="radio" name="n_src" value="blank"><div><b>空白流程</b><span>只带一条泳道，从零搭建</span></div></label>
    <div class="acts"><button class="btn" type="button" data-mclose>取消</button><button class="btn primary" type="button" id="n_ok">创建</button></div>`);
  $('#n_ok').onclick=()=>{
    const src=document.querySelector('input[name=n_src]:checked').value;
    const base=src==='tpl'?clone(TEMPLATE):{name:'',desc:'',lanes:[{id:uid('l'),name:'主流程',color:'blue'}],steps:[]};
    const f=normFlow(base);f.name=$('#n_name').value.trim()||(src==='tpl'?'AOR 对接流程（副本）':'新流程');
    f.order=Math.max(0,...Object.values(flows).map(x=>x.order))+1;
    const id=uid('f');flows[id]=f;curId=id;closeModal();persist(id);render();toast('流程已创建');
  };
}

async function exportJson(){
  const f=cur();if(!f)return;
  const data=JSON.stringify({format:'aor-flow-manager',version:1,flow:f},null,2);
  const name=(f.name.replace(/[\\/:*?"<>|\s]+/g,'_')||'flow')+'.json';
  try{const d=await window.claude?.use?.('downloads');if(d){const r=await d.save({filename:name,data});if(r)toast('已导出');return}}catch(e){if(e&&e.code==='declined')return}
  if(!window.claude){try{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type:'application/json'}));a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},500);toast('已导出');return}catch(e){}}
  modal(`<h3>导出 JSON</h3><p>复制下面的内容保存为 .json 文件，可在任何流程管理页面中导入。</p><textarea id="expTxt" style="width:100%;height:220px;font-family:var(--f-mono);font-size:12px;border:1px solid var(--line-2);border-radius:8px;padding:8px;background:var(--bg)" readonly>${esc(data)}</textarea><div class="acts"><button class="btn" type="button" data-mclose>关闭</button><button class="btn primary" type="button" id="cpy">复制</button></div>`);
  $('#cpy').onclick=async()=>{const t=$('#expTxt');try{await navigator.clipboard.writeText(t.value);toast('已复制')}catch(e){t.select();toast('请按 Ctrl/⌘ + C 复制')}};
}
function importJson(file){
  const r=new FileReader();
  r.onload=()=>{try{
    const o=JSON.parse(r.result);const raw=o&&o.flow?o.flow:o;
    if(!raw||!Array.isArray(raw.steps)||!Array.isArray(raw.lanes))throw new Error();
    const f=normFlow(raw);f.order=Math.max(0,...Object.values(flows).map(x=>x.order))+1;
    const id=uid('f');flows[id]=f;curId=id;persist(id);render();toast(`已导入「${f.name}」`);
  }catch(e){toast('文件格式不对：需要从本页面导出的流程 JSON')}};
  r.readAsText(file);
}

document.addEventListener('click',e=>{
  const t=e.target.closest('button,[data-step],label');if(!t)return;
  const d=t.dataset;
  if(d.flow){curId=d.flow;sel=null;closeDrawerSilently();render();return}
  if(d.step){editStep(d.step);return}
  if(d.addstep){addStep(d.addstep);return}
  if(d.laneedit){editLane(d.laneedit);return}
  if(d.lanemove){const f=cur(),i=f.lanes.findIndex(l=>l.id===d.lanemove),j=i+Number(d.dir);if(j<0||j>=f.lanes.length)return;[f.lanes[i],f.lanes[j]]=[f.lanes[j],f.lanes[i]];persist(curId);render();return}
  if(d.color){const w=$('#l_color');w.dataset.val=d.color;w.querySelectorAll('.sw').forEach(b=>b.classList.toggle('on',b.dataset.color===d.color));return}
  if(d.stepmove){const id=sel&&sel.id;if(!id)return;readStepForm(cur().steps.find(x=>x.id===id));if(moveStep(id,Number(d.stepmove))){persist(curId);render();toast('已移动')}else toast('已经在泳道'+(d.stepmove<0?'最前面':'最后面'));return}
  if(d.close!==undefined){closeDrawer();return}
  if(d.mclose!==undefined){closeModal();return}
  if(d.act==='newflow'){newFlowModal();return}
  if(d.act==='addlane'){editLane(null);return}
  switch(t.id){
    case 'btnNewFlow':newFlowModal();break;
    case 'btnFlowSettings':editFlow();break;
    case 'btnAddLane':if(cur())editLane(null);break;
    case 'btnExport':exportJson();break;
    case 'vBoard':view='board';$('#vBoard').classList.add('on');$('#vTable').classList.remove('on');render();break;
    case 'vTable':view='table';$('#vTable').classList.add('on');$('#vBoard').classList.remove('on');render();break;
    case 'dClose':closeDrawer();break;
    case 'e_save':{const s=cur().steps.find(x=>x.id===sel.id);readStepForm(s);persist(curId);closeDrawer();toast('环节已保存');break}
    case 'e_dup':{const f=cur(),s=f.steps.find(x=>x.id===sel.id);readStepForm(s);const c=clone(s);c.id=uid('s');c.title+='（副本）';f.steps.splice(f.steps.indexOf(s)+1,0,c);persist(curId);editStep(c.id);toast('已复制');break}
    case 'e_insert':{const s=cur().steps.find(x=>x.id===sel.id);readStepForm(s);addStep(s.lane,s.id);break}
    case 'e_del':{const id=sel.id,s=cur().steps.find(x=>x.id===id);confirmBox('删除环节',`确定删除「${s.title}」？此操作不能撤销。`,'删除',()=>{const f=cur();f.steps=f.steps.filter(x=>x.id!==id);persist(curId);closeDrawer();toast('环节已删除')});break}
    case 'l_save':{const f=cur(),name=$('#l_name').value.trim()||'新泳道',color=$('#l_color').dataset.val;
      if(sel.id){Object.assign(f.lanes.find(l=>l.id===sel.id),{name,color})}else{f.lanes.push({id:uid('l'),name,color})}
      persist(curId);closeDrawer();toast(sel.id?'泳道已保存':'泳道已添加');break}
    case 'l_del':{const id=sel.id,f=cur(),l=f.lanes.find(x=>x.id===id);confirmBox('删除泳道',`确定删除「${l.name}」及其中 ${laneSteps(f,id).length} 个环节？此操作不能撤销。`,'删除',()=>{f.lanes=f.lanes.filter(x=>x.id!==id);f.steps=f.steps.filter(s=>s.lane!==id);persist(curId);closeDrawer();toast('泳道已删除')});break}
    case 'f_save':{const f=cur();f.name=$('#f_name').value.trim()||'未命名流程';f.desc=$('#f_desc').value.trim();f.order=Number($('#f_order').value)||0;persist(curId);closeDrawer();toast('流程已保存');break}
    case 'f_dup':{const c=clone(cur());c.name+='（副本）';c.order=Math.max(0,...Object.values(flows).map(x=>x.order))+1;const id=uid('f');flows[id]=normFlow(c);curId=id;persist(id);closeDrawer();toast('已复制为新流程');break}
    case 'f_del':{const f=cur();confirmBox('删除流程',`确定删除「${f.name}」？其中 ${f.steps.length} 个环节都会被删除，此操作不能撤销。建议先导出 JSON 备份。`,'删除流程',async()=>{const id=curId;await removeFlow(id);curId=sortedFlows()[0]?.[0]||null;closeDrawer();toast('流程已删除')});break}
  }
});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){if($('#mw'))closeModal();else if($('#drawer').classList.contains('open'))closeDrawer()}
  if(e.key==='Enter'&&e.target.matches('tr[data-step]'))editStep(e.target.dataset.step);
});
$('#scrim').onclick=closeDrawer;
$('#modalRoot').addEventListener('click',e=>{if(e.target.id==='mw')closeModal()});
function closeDrawerSilently(){$('#drawer').classList.remove('open');$('#scrim').hidden=true}
let qTimer;$('#q').addEventListener('input',e=>{clearTimeout(qTimer);qTimer=setTimeout(()=>{filters.q=e.target.value;render()},120)});
$('#fOwner').addEventListener('change',e=>{filters.owner=e.target.value;render()});
$('#fAi').addEventListener('change',e=>{filters.ai=e.target.value;render()});
$('#importFile').addEventListener('change',e=>{const f=e.target.files[0];if(f)importJson(f);e.target.value=''});

function applyWriteState(){
  ['btnNewFlow','btnAddLane','btnImport'].forEach(id=>{const el=$('#'+id);if(el){el.hidden=!canWrite}});
  render();
}

function startLocal(reason){
  mode='local';
  const saved=loadLocal();
  if(saved&&Object.keys(saved).length){for(const[k,v]of Object.entries(saved))flows[k]=normFlow(v)}
  else{flows['aor-onboarding']=normFlow(TEMPLATE);saveLocal()}
  curId=curId&&flows[curId]?curId:sortedFlows()[0]?.[0]||null;
  setSync('warn','仅保存在本浏览器');
  banner(`数据保存在当前浏览器${reason?'（'+esc(reason)+'）':''}：换电脑、换浏览器或清除浏览器数据后看不到。要备份或分享给同事，请用「导出 JSON」，对方用「导入 JSON」打开。`);
  render();
}
async function boot(){
  render();
  let api=null;
  try{api=window.claude&&window.claude.use?await window.claude.use('db'):null}catch(e){api=null}
  if(!api){startLocal(window.claude?'未连接到共享存储':'');return}
  db=api;mode='db';
  try{const u=await window.claude.use('user');if(u){const c=await u.can('data.write');if(c===false)canWrite=false}}catch(e){}
  const timer=setTimeout(()=>{setSync('warn','连接较慢');if(!Object.keys(flows).length)banner('暂时连不上共享存储，数据加载后会自动显示。')},10000);
  db.collection('flows').onSnapshot(snap=>{
    if(!snap.metadata.fromCache){clearTimeout(timer);banner('');setSync('ok',canWrite?'已同步 · 团队共享':'只读 · 团队共享')}
    const next={};snap.docs.forEach(d=>{next[d.id]=normFlow(d.data())});
    flows=next;
    if(!curId||!flows[curId])curId=sortedFlows()[0]?.[0]||null;
    applyWriteState();
    if(sel&&sel.kind==='step'&&!(cur()&&cur().steps.some(s=>s.id===sel.id)))closeDrawer();
  },err=>{clearTimeout(timer);setSync('warn','连接中断');banner('共享存储连接中断，请刷新页面重试。已显示的内容可能不是最新的。')});
}
boot();
</script>

